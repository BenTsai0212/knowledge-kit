{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(git push --force-with-lease origin*)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(gh auth status*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr create*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr edit*)",
      "Bash(gh api*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(mkdir*)",
      "Bash(mktemp*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr checkout*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo*)",
      "Bash(gh secret*)",
      "Bash(gh label delete*)",
      "Bash(gh release*)",
      "Bash(gh api*merge*)",
      "Bash(gh api*-X DELETE*)",
      "Bash(gh api*-XDELETE*)",
      "Bash(gh api*--method DELETE*)",
      "Bash(gh api*--method=DELETE*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push* +main*)",
      "Bash(git push*:main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push*--delete*)",
      "Bash(git push* -d *)",
      "Bash(git push*--force)",
      "Bash(git push*--force *)",
      "Bash(git push* -f*)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache"
      ]
    }
  }
}
