{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "access.schema.json",
  "title": "access.json：可見等級、專案名單、角色",
  "type": "object",
  "additionalProperties": false,
  "required": ["visibilityLevels", "projects", "roles"],
  "properties": {
    "visibilityLevels": {
      "description": "rank 越大越機密；角色可看到 rank 小於等於其 visibility 的內容",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "rank"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Id" },
          "label": { "$ref": "common.schema.json#/definitions/LocalizedText" },
          "rank": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Id" },
          "label": { "$ref": "common.schema.json#/definitions/LocalizedText" }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "visibility", "projects"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Id" },
          "label": { "$ref": "common.schema.json#/definitions/LocalizedText" },
          "visibility": { "description": "可見等級的 id", "$ref": "common.schema.json#/definitions/Id" },
          "projects": {
            "description": "可看到的專案 id",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/definitions/Id" }
          }
        }
      }
    }
  }
}
