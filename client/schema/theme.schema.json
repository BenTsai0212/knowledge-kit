{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "theme.schema.json",
  "title": "theme.json：色票（淺色與深色）、圓角、字體",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors", "darkColors", "radius", "fonts"],
  "definitions": {
    "Color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "ColorAlpha": { "description": "帶透明度的顏色 #RRGGBBAA", "type": "string", "pattern": "^#[0-9A-Fa-f]{8}$" },
    "Length": { "description": "CSS 長度，單位為 px 或 rem", "type": "string", "pattern": "^(0|[0-9]+(\\.[0-9]+)?(px|rem))$" },
    "FontStack": { "description": "CSS font-family 值", "type": "string", "minLength": 1 }
  },
  "properties": {
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "onPrimary",
        "background",
        "surface",
        "text",
        "textMuted",
        "border",
        "danger",
        "warning",
        "success",
        "info",
        "onStatus",
        "mark",
        "overlay",
        "graphFallback",
        "surfaceRaised",
        "reading",
        "readingText",
        "focus",
        "markSoft",
        "markText",
        "markReading",
        "conflict",
        "conflictSoft",
        "conflictText"
      ],
      "properties": {
        "primary": { "$ref": "#/definitions/Color" },
        "onPrimary": { "$ref": "#/definitions/Color" },
        "background": { "$ref": "#/definitions/Color" },
        "surface": { "$ref": "#/definitions/Color" },
        "text": { "$ref": "#/definitions/Color" },
        "textMuted": { "$ref": "#/definitions/Color" },
        "border": { "$ref": "#/definitions/Color" },
        "danger": { "$ref": "#/definitions/Color" },
        "warning": { "$ref": "#/definitions/Color" },
        "success": { "$ref": "#/definitions/Color" },
        "info": { "$ref": "#/definitions/Color" },
        "onStatus": { "$ref": "#/definitions/Color" },
        "mark": { "description": "證據色（ADR 0008，客戶不可改）：選取的引用、原文螢光", "$ref": "#/definitions/Color" },
        "overlay": { "$ref": "#/definitions/ColorAlpha" },
        "graphFallback": { "$ref": "#/definitions/Color" },
        "surfaceRaised": { "description": "列、晶片、次要區塊", "$ref": "#/definitions/Color" },
        "reading": { "description": "原文閱讀紙面（深色模式也是亮色）", "$ref": "#/definitions/Color" },
        "readingText": { "description": "reading 紙面上的文字", "$ref": "#/definitions/Color" },
        "focus": { "description": "鍵盤焦點框（:focus-visible）", "$ref": "#/definitions/Color" },
        "markSoft": { "description": "證據色（ADR 0008，客戶不可改）：引用標號的預設底色", "$ref": "#/definitions/Color" },
        "markText": { "description": "證據色（ADR 0008，客戶不可改）：證據底色上的文字", "$ref": "#/definitions/Color" },
        "markReading": { "description": "證據色（ADR 0008，客戶不可改）：reading 紙面上的螢光", "$ref": "#/definitions/Color" },
        "conflict": { "description": "說法不同：圖示、框線、文字", "$ref": "#/definitions/Color" },
        "conflictSoft": { "description": "說法不同的底色", "$ref": "#/definitions/Color" },
        "conflictText": { "description": "conflictSoft 上的文字", "$ref": "#/definitions/Color" }
      }
    },
    "darkColors": {
      "description": "深色模式（prefers-color-scheme: dark）的色票，鍵與 colors 相同",
      "$ref": "#/properties/colors"
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small", "medium", "large", "pill"],
      "properties": {
        "small": { "$ref": "#/definitions/Length" },
        "medium": { "$ref": "#/definitions/Length" },
        "large": { "$ref": "#/definitions/Length" },
        "pill": { "$ref": "#/definitions/Length" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "heading", "mono", "display"],
      "properties": {
        "body": { "$ref": "#/definitions/FontStack" },
        "heading": { "$ref": "#/definitions/FontStack" },
        "mono": { "description": "等寬：ID、數量、關係名稱、引用標號", "$ref": "#/definitions/FontStack" },
        "display": { "description": "只用於字標與大數字", "$ref": "#/definitions/FontStack" }
      }
    }
  }
}
