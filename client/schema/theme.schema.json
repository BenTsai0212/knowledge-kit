{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "theme.schema.json",
  "title": "theme.json：色票、字體",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors", "fonts"],
  "definitions": {
    "Color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "FontStack": { "description": "CSS font-family 值", "type": "string", "minLength": 1 }
  },
  "properties": {
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "onPrimary", "background", "surface", "text", "textMuted", "border"],
      "properties": {
        "primary": { "$ref": "#/definitions/Color" },
        "onPrimary": { "$ref": "#/definitions/Color" },
        "background": { "$ref": "#/definitions/Color" },
        "surface": { "$ref": "#/definitions/Color" },
        "text": { "$ref": "#/definitions/Color" },
        "textMuted": { "$ref": "#/definitions/Color" },
        "border": { "$ref": "#/definitions/Color" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "heading"],
      "properties": {
        "body": { "$ref": "#/definitions/FontStack" },
        "heading": { "$ref": "#/definitions/FontStack" }
      }
    }
  }
}
