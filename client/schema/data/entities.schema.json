{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data/entities.schema.json",
  "title": "data/entities.json：實體",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "name", "sources"],
        "properties": {
          "id": { "$ref": "../common.schema.json#/definitions/Id" },
          "type": { "description": "knowledge-model.json 的實體類型 id", "$ref": "../common.schema.json#/definitions/Id" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": {
            "description": "其他名稱，例如英文名；目前不寫入資料庫",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": { "$ref": "#/definitions/Sources" }
        }
      }
    }
  },
  "definitions": {
    "Sources": {
      "description": "出處段落的 id",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../common.schema.json#/definitions/Id" }
    }
  }
}
