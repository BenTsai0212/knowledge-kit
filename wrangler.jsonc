// 只供本機 wrangler dev；不含部署設定（routes、account_id、自訂網域）。
{
  "name": "knowledge-kit",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
